# ============================================
# HTACCESS - API
# ============================================

# Erlaube nur api.php
<FilesMatch "^(?!api\.php$).*\.php$">
    Require all denied
</FilesMatch>

# Blockiere direkte Aufrufe von Unterordnern
RedirectMatch 403 ^/api/(handlers|helpers)/

# Keine CORS-Header (OI-126): Alle Oberflächen laufen auf demselben Ursprung
# wie die API. Nicht „bei Bedarf“ einschalten — eine konkrete Origin zusammen
# mit Allow-Credentials machte jede Sitzungsantwort für diese Origin lesbar.

# Rate Limiting (optional, wenn mod_ratelimit verfügbar)
 <IfModule mod_ratelimit.c>
     SetOutputFilter RATE_LIMIT
     SetEnv rate-limit 600
 </IfModule>
# ============================================
# HTACCESS - Root (public/)
# ============================================

# Engine aktivieren
RewriteEngine On

# ============================================
# HTTPS REDIRECT (nur Production)
# ============================================
# Aktiviere diese Zeilen NUR auf dem Live-Server!
# Lokal auskommentiert lassen

# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# SICHERHEIT
# ============================================

# Verzeichnis-Listings verhindern
Options -Indexes

# Zugriff auf sensible Dateien blockieren
<FilesMatch "\.(lock|sql|md|sh|bat|config)$">
    Require all denied
</FilesMatch>

# .htaccess selbst schützen
<Files .htaccess>
    Require all denied
</Files>

# ============================================
# SICHERHEITS-HEADER
# ============================================
# Bewusst OHNE Content-Security-Policy: Die Oberflaeche traegt 95 onclick-
# Attribute in index.html. Eine CSP ohne 'unsafe-inline' legt sie still, eine
# CSP mit 'unsafe-inline' waere gegen XSS wirkungslos und damit nur Fassade.
# Der Weg dorthin steht als OI-17 in docs/OPEN-ITEMS.md.
<IfModule mod_headers.c>
    # Kein MIME-Sniffing -- ein hochgeladenes Logo bleibt ein Bild
    Header always set X-Content-Type-Options "nosniff"

    # Kein Einbetten in fremde Seiten; die Anwendung nutzt selbst keine iframes
    Header always set X-Frame-Options "DENY"

    # Kein Pfad im Referrer an fremde Ziele -- Termin- und Mitglieds-IDs
    # stehen in den URLs der Anwendung
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Authorization-Header an PHP durchreichen (XAMPP/Apache strippt ihn sonst)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ============================================
# INDEX Rewrite
# ============================================

# Index-Datei festlegen
DirectoryIndex index.html index.php

# Verhindere dass index.php im Pfad erscheint
RewriteEngine On
RewriteCond %{REQUEST_URI} ^(.*)/index\.(html|php)$
RewriteRule ^(.*)$ %1/ [R=301,L]

# ============================================
# MIME-TYPES (für PWA)
# ============================================
AddType application/manifest+json .json
AddType application/x-web-app-manifest+json .webapp
AddType text/cache-manifest .appcache

# ============================================
# CACHING
# ============================================
# Die Anwendung hat keine Build-Kette und keine Content-Hashes im Dateinamen.
# Damit ein Update bei den Mitgliedern ankommt, muss der Browser vor der
# Wiederverwendung nachfragen. "no-cache" heisst nicht "nicht cachen", sondern
# "vor Benutzung revalidieren" -- unveraenderte Dateien beantwortet Apache per
# ETag mit 304, der Mehraufwand ist also eine leere Antwort.
#
# Der Versions-Query an den CSS-Links reicht dafuer nicht aus: Die ES-Module
# unter js/modules/ importieren sich gegenseitig relativ, und diese Importe
# erben den Query des Script-Tags nicht. Ihn dort anzuhaengen waere sogar
# schaedlich, weil dieselbe Datei dann zweimal als getrenntes Modul geladen
# wuerde -- mit doppeltem Zustand.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Bilder aendern sich praktisch nie und duerfen liegen bleiben.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# ============================================
# COMPRESSION (optional)
# ============================================
# <IfModule mod_deflate.c>
#    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
# </IfModule>
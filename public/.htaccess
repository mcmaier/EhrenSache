# ============================================
# HTACCESS - Root (public/)
# ============================================

# Engine aktivieren
RewriteEngine On

# ============================================
# HTTPS REDIRECT
# ============================================
# Aktiv ausgeliefert: Die Anwendung verarbeitet personenbezogene Daten, und ein
# Verein, der die Zeilen von Hand aktiviert, verlöre sie beim naechsten Update
# wieder -- diese Datei liegt im Paket und wird ueberschrieben.
#
# Die drei Ausnahmen sind kein Beiwerk, sondern verhindern eine Endlosschleife:
# Bei Shared Hosting mit TLS-Terminierung am Proxy steht %{HTTPS} auf off,
# obwohl der Besucher laengst ueber HTTPS kommt. Dieselbe dreifache Pruefung
# steht in public/api/api.php fuer das Secure-Flag der Session.
#
# Die vierte Ausnahme haelt die lokale Entwicklung lauffaehig; kein Livesystem
# heisst localhost. Wer lokal mit HTTPS testet, braucht dafuer nichts zu aendern.

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{SERVER_PORT} !^443$
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# VERSIONIERTE PFADE (OI-120, OI-74)
# ============================================
# Dashboard und Anmeldeseite laden CSS und JS ueber css/v<Version>/… und
# js/v<Version>/…. Relative import- und @import-Pfade erben den Abschnitt, so
# traegt jede Datei die Version, ohne dass eine Importzeile ihn kennt -- und
# keine Datei wird unter zwei Adressen geladen (doppelte Module). Hier wird der
# Abschnitt intern entfernt; die Dateien liegen, wo sie immer lagen.
#
# Die Bedingung liest den vollen URL-Pfad, damit die Ersetzung absolut ist und
# auch in einer Installation unter einem Unterordner (lokal /EhrenSache/public/)
# ohne RewriteBase stimmt. Das Muster ist eng (v, Ziffer, dann Ziffern und
# Punkte), damit js/vendor/ nicht getroffen wird. E=ES_VERSIONED markiert die
# Antwort fuer das lange Caching unten (Abschnitt CACHING).
#
# Abgebildet werden nur schlichte .css- und .js-Dateien unter css/ und js/:
# Buchstaben, Ziffern, _ . / -, kein % und kein "..". %{REQUEST_URI} ist schon
# dekodiert, das interne Umschreiben dekodiert ein zweites Mal -- mit weitem
# Muster wurde aus js/v…/%252e%252e/login.html die Anmeldeseite, ausgeliefert
# mit einem Jahr Cache. Alles andere unter v<Version>/ endet jetzt mit 404.
# CSS-Buendel (OI-120 Weg 1): main.css und login.css unter Version kommen als
# eine Antwort aus css/bundle.php, das die @import-Zeilen aufloest -- statt 22
# bzw. 3 Anfragen eine. bundle.php setzt Cache-Control selbst (immutable nur
# fuer die aktuelle Version); der FilesMatch-Block unten greift fuer .php
# nicht. Steht vor der allgemeinen Regel, die mit [L] endet.
# Rueckfall: Die Regel greift nur, wenn bundle.php existiert (-f). Der Updater
# tauscht public/.htaccess frueher als public/css/bundle.php; in der Luecke
# wuerde die Regel sonst 404 fuer main.css liefern. Ohne -f faellt die Anfrage
# auf die allgemeine Regel darunter durch und bekommt die statische main.css
# mit ihren @import.
# Reihenfolge der Bedingungen: %N verweist auf die ZULETZT geprueften Muster;
# die REQUEST_URI-Bedingung steht deshalb zuletzt, ihr %1 ist der URL-Praefix
# der Installation (lokal /EhrenSache/public). Der Pfad im Dateisystem kommt
# aus REQUEST_FILENAME (der bestehende Teil des Pfads -- endet bei css/v<Version>,
# weil es das Verzeichnis nicht gibt; der Rest ist PATH_INFO; Windows
# schreibt Rueckwaerts- oder Schraegstriche, daher die Zeichenklassen mit
# beiden; \x5C statt eines Backslash, den der Konfigurationsleser verschluckt).
# Der Einstieg main|login kommt aus $1.
RewriteCond %{REQUEST_FILENAME} ^(.+)[/\x5C]css[/\x5C]v[0-9][0-9.]*(?:[/\x5C]|$)
RewriteCond %1/css/bundle.php -f
RewriteCond %{REQUEST_URI} ^(.*)/css/v[0-9][0-9.]*/(main|login)\.css$
RewriteRule ^css/v[0-9][0-9.]*/(main|login)\.css$ %1/css/bundle.php?entry=$1 [L]

RewriteCond %{REQUEST_URI} ^(.*)/(css|js)/v[0-9][0-9.]*/([A-Za-z0-9_./-]+\.(?:css|js))$
RewriteCond %3 !\.\.
RewriteRule ^(css|js)/v[0-9][0-9.]*/[A-Za-z0-9_./-]+\.(?:css|js)$ %1/%2/%3 [L,E=ES_VERSIONED:1]

# ============================================
# SICHERHEIT
# ============================================

# Verzeichnis-Listings verhindern
Options -Indexes

# Zugriff auf sensible Dateien blockieren
<FilesMatch "\.(lock|sql|md|sh|bat|config)$">
    Require all denied
</FilesMatch>

# .htaccess selbst schützen
<Files .htaccess>
    Require all denied
</Files>

# ============================================
# SICHERHEITS-HEADER
# ============================================
# Content-Security-Policy (OI-17): Anmeldung und Dashboard mit script-src 'self',
# die oeffentlichen PHP-Seiten ohne jedes Skript (script-src 'none'). Bewusst in
# Files-Abschnitten, nicht auf Verzeichnisebene -- sonst griffe sie auch in
# install/ und update/, die dafuer nicht vorbereitet sind. Check-in-PWA und
# Station setzen ihre Richtlinie in der eigenen .htaccess.
# tests/suites/csp.php haelt das fest; Knoepfe laufen ueber data-action
# (public/js/modules/actions.js), nie ueber on…-Attribute.
#
# style-src 'unsafe-inline' ist eine bewusste Ausnahme: Inline-Styles sind
# das deutlich kleinere Risiko, und die Seiten tragen noch style-Attribute.
<IfModule mod_headers.c>
    <Files "login.html">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    </Files>
    # setifempty, nicht set: <Files "index.html"> trifft auch checkin/index.html
    # und station/index.html und wird nach deren .htaccess ausgewertet. Mit set
    # ueberschriebe die Dashboard-Richtlinie die eigene der PWA (dort z. B.
    # img-src data:). So gilt sie nur, wo noch keine Richtlinie gesetzt ist.
    <Files "index.html">
        Header always setifempty Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    </Files>
    <FilesMatch "^(reset_password|verify_email)\.php$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    # Kein MIME-Sniffing -- ein hochgeladenes Logo bleibt ein Bild
    Header always set X-Content-Type-Options "nosniff"

    # Kein Einbetten in fremde Seiten; die Anwendung nutzt selbst keine iframes
    Header always set X-Frame-Options "DENY"

    # Kein Pfad im Referrer an fremde Ziele -- Termin- und Mitglieds-IDs
    # stehen in den URLs der Anwendung
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Authorization-Header an PHP durchreichen (XAMPP/Apache strippt ihn sonst)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ============================================
# INDEX Rewrite
# ============================================

# Index-Datei festlegen
DirectoryIndex index.html index.php

# Verhindere dass index.php im Pfad erscheint
RewriteEngine On
RewriteCond %{REQUEST_URI} ^(.*)/index\.(html|php)$
RewriteRule ^(.*)$ %1/ [R=301,L]

# ============================================
# MIME-TYPES (für PWA)
# ============================================
AddType application/manifest+json .json
AddType application/x-web-app-manifest+json .webapp
AddType text/cache-manifest .appcache

# ============================================
# CACHING
# ============================================
# Die Anwendung hat keine Build-Kette und keine Content-Hashes im Dateinamen.
# Ohne Versionsangabe muss der Browser vor der Wiederverwendung nachfragen:
# "no-cache" heisst nicht "nicht cachen", sondern "vor Benutzung revalidieren"
# -- unveraenderte Dateien beantwortet Apache per ETag mit 304.
#
# Dashboard und Anmeldeseite laden CSS und JS ueber versionierte Pfade
# (Abschnitt VERSIONIERTE PFADE). Diese Antworten duerfen ein Jahr liegen
# (immutable): Ein Update aendert den Pfad, also die Adresse. Wiederkehrende
# Nutzer schicken dafuer keine einzige Anfrage mehr -- auf Shared Hosting mit
# knapper Grenze gleichzeitiger Prozesse war genau diese Welle das Problem
# (OI-120). Die HTML-Seiten tragen die Version und bleiben no-cache, ebenso
# Check-in-App und Station, die ihre wenigen Dateien per ?v= versionieren.
#
# main.css und login.css unter Version liefert css/bundle.php als Buendel aus
# (Abschnitt VERSIONIERTE PFADE) und setzt Cache-Control selbst. Die
# Einzeldateien bleiben unter ihren Pfaden erreichbar, ohne Version weiter
# no-cache.
#
# Ein Query (?v=) an den Modul-Importen waere kein Ersatz: Eine Stelle ohne ihn
# laedt dieselbe Datei als zweites Modul -- mit doppeltem Zustand.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
        # Nach dem internen Umschreiben durch die Regel VERSIONIERTE PFADE heisst
        # deren Markierung REDIRECT_ES_VERSIONED; env=ES_VERSIONED greift hier
        # nicht (am 2026-10-05 per curl geprueft).
        Header set Cache-Control "public, max-age=31536000, immutable" env=REDIRECT_ES_VERSIONED
    </FilesMatch>
</IfModule>

# Bilder aendern sich praktisch nie und duerfen liegen bleiben.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# ============================================
# COMPRESSION (optional)
# ============================================
# <IfModule mod_deflate.c>
#    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
# </IfModule>